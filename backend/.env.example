# =============================================
# College Attendance Tracker - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# =============================================

# --- Server ---
NODE_ENV=development
PORT=5000

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/college_attendance_tracker

# --- JWT ---
# Use a long, random, secret string (at least 64 characters)
JWT_ACCESS_SECRET=your_access_token_secret_here
JWT_REFRESH_SECRET=your_refresh_token_secret_here

# Access token expires in (e.g. 15m, 1h)
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token expires in (e.g. 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# --- Rate Limiting ---
# Max requests per IP per window (in milliseconds)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

