            "url": { "raw": "{{baseUrl}}/analytics/risk-detection?departmentId={{departmentId}}&semester=1&attendanceThreshold=75", "host": ["{{baseUrl}}"], "path": ["analytics", "risk-detection"] }
          }
        }
      ]
    },
    {
      "name": "8. In-App Notifications",
      "item": [
